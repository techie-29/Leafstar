# Copy to .env.local and fill in. NEVER commit .env.local, never paste these into a chat.
# Supabase → Project Settings → API

# Public by design (the anon key opens only the two public views; every table is locked by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET — server only
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
# Any long random text (at least 24 characters); protects the scheduled maintenance route
CRON_SECRET=

# Added in Step 9
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
EMAIL_API_KEY=

# Only for running the database tests yourself (a local Postgres you can create databases in)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
